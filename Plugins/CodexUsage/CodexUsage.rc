#include <windows.h>
#include "OptionsResource.h"
IDD_CODEX_OPTIONS DIALOGEX 0, 0, 320, 361
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Codex Usage options"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Refresh interval", IDC_POLL_LABEL, 12, 9, 94, 12
    COMBOBOX IDC_POLL, 112, 6, 196, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Theme", IDC_THEME_LABEL, 12, 28, 94, 12
    COMBOBOX IDC_THEME, 112, 25, 196, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Quota bar", IDC_BAR_LABEL, 12, 47, 94, 12
    COMBOBOX IDC_BAR, 112, 44, 196, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Text style", IDC_TEXT_LABEL, 12, 66, 94, 12
    COMBOBOX IDC_TEXT, 112, 63, 196, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL "Show 5-hour quota", IDC_SESSION, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 84, 142, 12
    CONTROL "Show 7-day quota", IDC_WEEKLY, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 164, 84, 144, 12
    CONTROL "Show reset cards", IDC_CARDS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 103, 142, 12
    CONTROL "Show time bar", IDC_TIME_BAR, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 164, 103, 144, 12
    CONTROL "Enable expiry warning", IDC_EXPIRY_WARNING, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 122, 142, 12
    EDITTEXT IDC_EXPIRY_TIME, 164, 119, 144, 14, ES_CENTER | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "7-day bar", IDC_WEEKLY_BAR_LABEL, 12, 144, 94, 12
    COMBOBOX IDC_WEEKLY_BAR_MODE, 112, 141, 196, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "5-hour cells", IDC_SESSION_BAR_LABEL, 12, 165, 94, 12
    COMBOBOX IDC_SESSION_BAR_MODE, 112, 162, 196, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "5-hour fill direction", IDC_SESSION_FILL_DIRECTION_LABEL, 12, 186, 94, 12
    COMBOBOX IDC_SESSION_FILL_DIRECTION, 112, 183, 196, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "7-day fill direction", IDC_WEEKLY_FILL_DIRECTION_LABEL, 12, 207, 94, 12
    COMBOBOX IDC_WEEKLY_FILL_DIRECTION, 112, 204, 196, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Week schedule", IDC_SCHEDULE_LABEL, 12, 228, 94, 12
    COMBOBOX IDC_REST_SCHEDULE, 112, 225, 196, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL "Use workday span on the 7-day bar", IDC_WEEKLY_WORK_HOURS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 246, 296, 14
    LTEXT "Morning", IDC_MORNING_LABEL, 12, 268, 94, 12
    EDITTEXT IDC_MORNING_START, 112, 265, 70, 14, ES_CENTER | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "to", IDC_MORNING_TO, 187, 268, 14, 12
    EDITTEXT IDC_MORNING_END, 205, 265, 70, 14, ES_CENTER | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Afternoon", IDC_AFTERNOON_LABEL, 12, 287, 94, 12
    EDITTEXT IDC_AFTERNOON_START, 112, 284, 70, 14, ES_CENTER | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "to", IDC_AFTERNOON_TO, 187, 287, 14, 12
    EDITTEXT IDC_AFTERNOON_END, 205, 284, 70, 14, ES_CENTER | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Position and background are managed by TrafficMonitor.", IDC_HINT, 12, 310, 296, 20
    DEFPUSHBUTTON "OK", IDOK, 152, 338, 72, 14
    PUSHBUTTON "Cancel", IDCANCEL, 236, 338, 72, 14
END
IDR_NETWORK_OFFLINE RCDATA "images\\network-offline.png"
