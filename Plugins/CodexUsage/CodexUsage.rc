#include <windows.h>
#include "OptionsResource.h"
IDD_CODEX_OPTIONS DIALOGEX 0, 0, 280, 229
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Codex Usage options"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Refresh interval", IDC_POLL_LABEL, 12, 14, 95, 12
    COMBOBOX IDC_POLL, 116, 12, 152, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Theme", IDC_THEME_LABEL, 12, 40, 95, 12
    COMBOBOX IDC_THEME, 116, 38, 152, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Quota bar", IDC_BAR_LABEL, 12, 66, 95, 12
    COMBOBOX IDC_BAR, 116, 64, 152, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Text style", IDC_TEXT_LABEL, 12, 92, 95, 12
    COMBOBOX IDC_TEXT, 116, 90, 152, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL "Show 5-hour quota", IDC_SESSION, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 120, 126, 12
    CONTROL "Show 7-day quota", IDC_WEEKLY, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 146, 120, 122, 12
    CONTROL "Show reset cards", IDC_CARDS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 142, 126, 12
    CONTROL "Show time bar", IDC_TIME_BAR, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 146, 142, 122, 12
    LTEXT "Position and background are managed by TrafficMonitor.", IDC_HINT, 12, 168, 256, 24
    DEFPUSHBUTTON "OK", IDOK, 116, 204, 72, 14
    PUSHBUTTON "Cancel", IDCANCEL, 196, 204, 72, 14
END
