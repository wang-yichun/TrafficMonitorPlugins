#include <windows.h>
#include "OptionsResource.h"

IDD_QODER_OPTIONS DIALOGEX 0, 0, 310, 310
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Qoder Usage options"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Refresh interval", IDC_QODER_POLL_LABEL, 12, 10, 100, 12
    COMBOBOX        IDC_QODER_POLL, 120, 8, 178, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Theme", IDC_QODER_THEME_LABEL, 12, 34, 100, 12
    COMBOBOX        IDC_QODER_THEME, 120, 32, 178, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Quota bar", IDC_QODER_BAR_LABEL, 12, 58, 100, 12
    COMBOBOX        IDC_QODER_BAR, 120, 56, 178, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Region", IDC_QODER_REGION_LABEL, 12, 82, 100, 12
    COMBOBOX        IDC_QODER_REGION, 120, 80, 178, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Low-quota alert", IDC_QODER_ALERT_LABEL, 12, 106, 100, 12
    COMBOBOX        IDC_QODER_ALERT, 120, 104, 178, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL         "Show total row", IDC_QODER_TOTAL, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 132, 138, 12
    CONTROL         "Show cycle countdown", IDC_QODER_CYCLE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 154, 132, 144, 12
    LTEXT           "Week schedule", IDC_QODER_SCHEDULE_LABEL, 12, 158, 100, 12
    COMBOBOX        IDC_QODER_REST_SCHEDULE, 120, 155, 178, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Morning", IDC_QODER_MORNING_LABEL, 12, 184, 100, 12
    EDITTEXT        IDC_QODER_MORNING_START, 120, 181, 60, 14, ES_CENTER | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "to", IDC_QODER_MORNING_TO, 184, 184, 16, 12
    EDITTEXT        IDC_QODER_MORNING_END, 204, 181, 60, 14, ES_CENTER | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Afternoon", IDC_QODER_AFTERNOON_LABEL, 12, 208, 100, 12
    EDITTEXT        IDC_QODER_AFTERNOON_START, 120, 205, 60, 14, ES_CENTER | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "to", IDC_QODER_AFTERNOON_TO, 184, 208, 16, 12
    EDITTEXT        IDC_QODER_AFTERNOON_END, 204, 205, 60, 14, ES_CENTER | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Position and background are managed by TrafficMonitor.", IDC_QODER_HINT, 12, 232, 286, 24
    DEFPUSHBUTTON   "OK", IDOK, 130, 278, 76, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 216, 278, 82, 14
END
