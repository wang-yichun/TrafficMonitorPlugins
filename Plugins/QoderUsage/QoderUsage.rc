#include <windows.h>
#include "OptionsResource.h"

IDD_QODER_OPTIONS DIALOGEX 0, 0, 300, 220
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Qoder Usage options"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Refresh interval", IDC_QODER_POLL_LABEL, 12, 14, 100, 12
    COMBOBOX        IDC_QODER_POLL, 120, 12, 168, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Theme", IDC_QODER_THEME_LABEL, 12, 38, 100, 12
    COMBOBOX        IDC_QODER_THEME, 120, 36, 168, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Quota bar", IDC_QODER_BAR_LABEL, 12, 62, 100, 12
    COMBOBOX        IDC_QODER_BAR, 120, 60, 168, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Region", IDC_QODER_REGION_LABEL, 12, 86, 100, 12
    COMBOBOX        IDC_QODER_REGION, 120, 84, 168, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Low-quota alert", IDC_QODER_ALERT_LABEL, 12, 110, 100, 12
    COMBOBOX        IDC_QODER_ALERT, 120, 108, 168, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL         "Show total row", IDC_QODER_TOTAL, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 138, 130, 12
    CONTROL         "Show cycle countdown", IDC_QODER_CYCLE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 150, 138, 140, 12
    LTEXT           "Position and background are managed by TrafficMonitor.", IDC_QODER_HINT, 12, 162, 276, 24
    DEFPUSHBUTTON   "OK", IDOK, 124, 194, 80, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 212, 194, 80, 14
END