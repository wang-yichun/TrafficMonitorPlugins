#include <windows.h>
#include "OptionsResource.h"

IDD_QODER_OPTIONS DIALOGEX 0, 0, 510, 250
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Qoder Usage options"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Refresh interval", IDC_QODER_POLL_LABEL, 12, 10, 100, 12
    COMBOBOX        IDC_QODER_POLL, 120, 8, 178, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Low-quota alert", IDC_QODER_ALERT_LABEL, 12, 34, 100, 12
    COMBOBOX        IDC_QODER_ALERT, 120, 32, 178, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Qoder executable", IDC_QODER_PATH_LABEL, 12, 64, 100, 12
    EDITTEXT        IDC_QODER_PATH, 120, 62, 285, 14, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON      "Browse...", IDC_QODER_PATH_BROWSE, 410, 61, 48, 16
    PUSHBUTTON      "Default", IDC_QODER_PATH_DEFAULT, 464, 61, 38, 16
    LTEXT           "Qoder CN executable", IDC_QODER_CN_PATH_LABEL, 12, 88, 100, 12
    EDITTEXT        IDC_QODER_CN_PATH, 120, 86, 285, 14, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON      "Browse...", IDC_QODER_CN_PATH_BROWSE, 410, 85, 48, 16
    PUSHBUTTON      "Default", IDC_QODER_CN_PATH_DEFAULT, 464, 85, 38, 16
    LTEXT           "WorkBuddy executable", IDC_WORKBUDDY_PATH_LABEL, 12, 112, 100, 12
    EDITTEXT        IDC_WORKBUDDY_PATH, 120, 110, 285, 14, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON      "Browse...", IDC_WORKBUDDY_PATH_BROWSE, 410, 109, 48, 16
    PUSHBUTTON      "Default", IDC_WORKBUDDY_PATH_DEFAULT, 464, 109, 38, 16
    LTEXT           "WorkBuddy CN executable", IDC_WORKBUDDY_CN_PATH_LABEL, 12, 136, 100, 12
    EDITTEXT        IDC_WORKBUDDY_CN_PATH, 120, 134, 285, 14, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON      "Browse...", IDC_WORKBUDDY_CN_PATH_BROWSE, 410, 133, 48, 16
    PUSHBUTTON      "Default", IDC_WORKBUDDY_CN_PATH_DEFAULT, 464, 133, 38, 16
    LTEXT           "Leave paths blank to use the default install locations. Choose the app's .exe file for a custom install.", IDC_QODER_HINT, 12, 162, 486, 34
    DEFPUSHBUTTON   "OK", IDOK, 326, 222, 76, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 414, 222, 82, 14
END
